# Postgres Neon — JANGAN pakai docker lagi. Isi otomatis via `neon env pull`
# (butuh `neon login` dulu). Contoh:
# DATABASE_URL="postgresql://neondb_owner:<password>@ep-...-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# API
API_PORT=4000
WEB_URL="http://localhost:3000"

# AI provider: "mock" = data simulasi (default, tanpa key).
# Untuk model beneran: AI_PROVIDER="http" + isi 3 baris di bawah.
AI_PROVIDER="mock"
# LLM_BASE_URL="https://..."
# LLM_API_KEY="isi-nanti"
# LLM_MODEL="muse-spark"

# Ekstraksi dokumen: "mock" = simulasi deterministik (default, gratis).
# "http" = field terstruktur via LLM (butuh LLM_* di atas); gagal → fallback mock.
EXTRACT_PROVIDER="mock"

# Auth demo lokal: "true" mengaktifkan POST /api/auth/demo-login (tanpa password).
# WAJIB "false" di deployment mana pun yang bisa diakses orang lain — ganti SSO/OAuth.
ALLOW_DEMO_LOGIN="true"

# Password akun dummy di halaman /login (default sss12345, sama untuk semua role).
# DUMMY_PASSWORD="sss12345"

# CORS: daftar origin eksplisit (koma). Default WEB_URL / localhost:3000.
# CORS_ORIGINS="http://localhost:3000"

# TTL key demo-login/rotate (hari). Seed awal NULL = tanpa expiry.
# KEY_TTL_DAYS="7"

# Rate limit per menit per user: chat, text-to-SQL, login.
# RATE_LIMIT_CHAT="30"
# RATE_LIMIT_QUERY="20"
# RATE_LIMIT_LOGIN="10"

# Embedding provider: hash (default, offline) | neural (transformers lokal, butuh onnxruntime) | http.
# Ganti provider WAJIB reindex: POST /api/documents/reindex (operations/management).
# EMBEDDING_PROVIDER="hash"
# EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
# EMBEDDING_BASE_URL="https://..."
# EMBEDDING_API_KEY="isi-nanti"
