# Postgres (docker-compose)
DATABASE_URL="postgresql://streetsmart:streetsmart@localhost:5433/streetsmart?schema=public"

# API
API_PORT=4000
WEB_URL="http://localhost:3000"

# AI provider: "mock" = data simulasi (default, tanpa key).
# Untuk model beneran: AI_PROVIDER="http" + isi 3 baris di bawah.
AI_PROVIDER="mock"
