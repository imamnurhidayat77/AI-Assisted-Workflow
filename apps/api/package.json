{
  "name": "@street-smart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/services/drafts.transitions.test.ts src/services/extract.test.ts src/services/sql.security.test.ts src/services/hardening.test.ts src/services/skills.test.ts src/services/spaceAccess.test.ts src/services/spaceContext.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "eval": "tsx eval/run.ts",
    "eval:answers": "tsx eval/score-answers.ts",
    "eval:extraction": "tsx eval/score-extraction.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@prisma/client": "^5.22.0",
    "@street-smart/shared": "*",
    "@types/multer": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pgvector": "^0.3.0",
    "socket.io": "^4.8.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
