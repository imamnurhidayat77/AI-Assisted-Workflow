{
  "name": "street-smart-cockpit",
  "private": true,
  "version": "0.1.0",
  "description": "Street Smart Cockpit — AI business operations ala SAP Joule untuk Smart City Street Ltd NZ",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "db:backup": "sh scripts/db-backup.sh",
    "test": "npm run test --workspace=packages/shared && npm run test --workspace=apps/api"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
